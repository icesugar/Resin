# Resin Docker Compose 示例
#
# 使用方式：复制本文件为 docker-compose.yml，按需修改后执行 `docker compose up -d`。
#
# 数据目录默认挂载到「docker-compose.yml 所在目录」下的 data/ 子目录：
#   ./data/cache -> /var/cache/resin（缓存，可清理）
#   ./data/state -> /var/lib/resin （持久化配置与状态，务必备份）
#   ./data/log   -> /var/log/resin （请求日志）
# Compose 以 compose 文件所在目录作为项目目录解析相对路径，
# 因此无论从哪个工作目录启动，数据都会落在 docker-compose.yml 同级目录中。
# 如需改用绝对路径或具名卷，直接替换 volumes 中的映射即可。
# 注意：data/ 需位于本地文件系统，NFS/SMB 等网络文件系统上 SQLite 存在数据损坏风险。

services:
  resin:
    build:
      context: .
      dockerfile: Dockerfile
    image: ghcr.io/resinat/resin:latest
    container_name: resin
    restart: unless-stopped
    environment:
      RESIN_ADMIN_TOKEN: ${RESIN_ADMIN_TOKEN}
      RESIN_PROXY_TOKEN: ${RESIN_PROXY_TOKEN}
      RESIN_LISTEN_ADDRESS: 0.0.0.0
      RESIN_PORT: ${RESIN_PORT:-2260}
      # 时区，例如 Asia/Shanghai
      # TZ: Asia/Shanghai
      # 绑定挂载目录已由容器入口脚本修正属主，如需跳过可设为 1
      # RESIN_SKIP_CHOWN: "0"
    ports:
      # 宿主机端口与容器内监听端口保持一致，均由 RESIN_PORT 控制
      - "${RESIN_PORT:-2260}:${RESIN_PORT:-2260}"
    volumes:
      # 相对路径基于 docker-compose.yml 所在目录解析
      - ./data/cache:/var/cache/resin
      - ./data/state:/var/lib/resin
      - ./data/log:/var/log/resin
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://127.0.0.1:${RESIN_PORT:-2260}/healthz >/dev/null || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
